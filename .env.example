# Copy to .env and adjust. Only PORT and DB_URL are required; every other
# variable falls back to the default shown.

# --- required ---
PORT=8080
DB_URL=postgres://postgres:postgres@localhost:5432/rss_aggregator?sslmode=disable

# --- logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP server ---
# Comma-separated. Wildcards are allowed.
CORS_ALLOWED_ORIGINS=https://*,http://*
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# --- database pool ---
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h

# --- scraper ---
# Feeds refreshed in parallel per pass (1-1000).
SCRAPER_CONCURRENCY=10
SCRAPER_INTERVAL=1m
# Budget for one whole feed: fetch plus storing every item it contains.
SCRAPER_REQUEST_TIMEOUT=30s
# Budget for the HTTP fetch alone. Must be shorter than the one above, so the
# inserts that follow a slow download still have time to run.
# Defaults to two thirds of SCRAPER_REQUEST_TIMEOUT.
SCRAPER_HTTP_TIMEOUT=20s
SCRAPER_USER_AGENT=rss-aggregator/1.0
# Feed URLs come from API clients. Leaving this false stops the scraper being
# pointed at loopback, RFC 1918 or link-local addresses such as the cloud
# metadata endpoint. Enable it only to scrape feeds on a trusted local network.
SCRAPER_ALLOW_PRIVATE_ADDRESSES=false

# --- pagination for GET /v1/posts ---
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
